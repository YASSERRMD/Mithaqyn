# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://mithaqyn:mithaqyn_password@localhost:5432/mithaqyn_db"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (for API key storage at rest)
ENCRYPTION_KEY=your-32-character-encryption-key!!

# File Storage
STORAGE_TYPE=local
LOCAL_UPLOAD_PATH=./uploads
# S3 (optional)
# AWS_S3_BUCKET=mithaqyn-documents
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# AI Providers — configure at least one
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-01

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
# GOOGLE_GEMINI_API_KEY=
# GOOGLE_GEMINI_MODEL=gemini-1.5-pro

# Mistral
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest

# Cohere
# COHERE_API_KEY=
# COHERE_MODEL=command-r-plus

# Groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-70b-versatile

# Together AI
# TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# DeepSeek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# OpenAI-Compatible Custom Endpoint
# Works with: LM Studio, vLLM, OpenRouter, LiteLLM, Fireworks, Together OpenAI-compatible, local enterprise gateways
# OPENAI_COMPAT_BASE_URL=http://localhost:8080/v1
# OPENAI_COMPAT_API_KEY=your-key-or-empty
# OPENAI_COMPAT_MODEL=your-model-name
# OPENAI_COMPAT_EMBEDDING_MODEL=your-embedding-model

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
